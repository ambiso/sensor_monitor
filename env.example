# GreptimeDB PostgreSQL-wire endpoint (port 4003 by default)
GREPTIMEDB_URL=postgresql://user:password@greptimedb.example:4003/public

# Stable identifier for this Raspberry Pi. Allowed: letters, numbers, ., - and _
NODE_ID=living-room

# Optional. The systemd unit defaults this to /var/lib/sensor_monitor/spool.db.
# SPOOL_PATH=/var/lib/sensor_monitor/spool.db
