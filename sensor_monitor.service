[Unit]
Description=SCD30 and SEN66 Air Quality Sensor Monitor
Documentation=
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi

# Path to the binary
ExecStart=/home/pi/sensor_monitor

# Environment file with GREPTIMEDB_URL, NODE_ID, and optional SPOOL_PATH
EnvironmentFile=/home/pi/env

# Durable queue used while GreptimeDB is unavailable
StateDirectory=sensor_monitor
StateDirectoryMode=0750

# Restart policy
Restart=always
RestartSec=10

# Security hardening
# NoNewPrivileges=yes
# ProtectSystem=strict
# ProtectHome=yes
# PrivateTmp=yes
# ProtectKernelTunables=yes
# ProtectControlGroups=yes

# Allow access to the Raspberry Pi I2C bus
SupplementaryGroups=i2c
DeviceAllow=/dev/i2c-1 rw

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sensor_monitor

[Install]
WantedBy=multi-user.target
